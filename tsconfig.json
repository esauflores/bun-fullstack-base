{
  // The settings for everything that runs in the Worker: the routes, the middleware, the crons, the queues, the API's code. The web
  // app has its own, src/web/tsconfig.json (which pages/tsconfig.json extends): this one, with DOM and JSX in place of
  // the Worker's types. .void/ holds Void's generated types: the routes' (for its typed fetch), the env's, the DB's, the
  // queues' (mapped to void/queues below, so `queues.daily.send()` takes queues/daily.ts's message).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "paths": {
      "@/*": ["./src/*"],
      "@schema/*": ["./db/schema/*"],
      "void/queues": ["./.void/queues.d.ts"]
    },
    "types": ["void/env", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "db", "routes", "middleware", "crons", "queues", "plugins", "*.ts", ".void/*.d.ts"],
  "exclude": ["src/web"]
}
