# One .env for the whole app, at the repo root: Bun loads it from there for `dev` and `start`, and
# src/config.ts reads and checks it (a bad value fails at start). Empty or missing values take the default.

# The one server's port: the API under /api and the web app, in development and in production.
PORT=3000

# Requests a minute each client may make to the API (/api/health aside), 300 when empty; 0 turns the limit off.
RATE_LIMIT=300

# The largest request body the API reads, in bytes, 1 MB when empty. Anything else fails at start.
MAX_BODY_BYTES=1048576

# The database file, relative to the repo root, where `dev` and `start` both run: .data/app.db when unset.
# /data/app.db when deployed to a container
# DATABASE_PATH=/data/app.db
