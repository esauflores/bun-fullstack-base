# Local settings for `bun run dev` and the local `void` commands: copy to .env (kept out of git). Declared and checked
# in env.ts; empty or missing values take their default. In production, set them with `void secret put <NAME>`.
# Named example.env, not .env.example: Void stops on any .env.* file, as it reads only .env.

# The largest request body the API reads, in bytes, 1 MB when empty.
MAX_BODY_BYTES=1048576

# The admin account's password (admin@example.com), who alone changes notes: a random one when unset, as only the
# cron writes as the admin. Read when the account is made, on a fresh database.
# ADMIN_PASSWORD=

# Fixed AI answers for the daily card instead of Workers AI's, which in dev needs a Cloudflare login
# (`void cloudflare login`) and spends the account's allowance. Remove to try the real models.
AI_FAKE=true
