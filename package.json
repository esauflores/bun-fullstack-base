{
  "name": "bun-fullstack-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "void prepare",
    "dev": "bun --bun vp dev",
    "build": "bun --bun vp build",
    "start": "bun dist/ssr/index.js",
    "db:generate": "bun --bun drizzle-kit generate --config=db/drizzle.config.ts",
    "bench": "bun --bun run build && bun --bun .scripts/bench.ts",
    "backup": "bun --bun .scripts/backup.ts",
    "check": "bun --bun vp check",
    "check:fix": "bun --bun vp check --fix",
    "test": "bun --bun vp test",
    "test:watch": "bun --bun vp test watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "void": "1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@void/react": "1.3.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "railway": "^3.16.0",
    "shadcn": "^4.22.1",
    "vite-plus": "^1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "bun@1.4.3"
}
